# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it contains secrets.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
TOKEN=

# Application (Client) ID from the "General Information" tab of your application
CLIENT_ID=

# The Discord server (guild) ID you want the bot to manage.
# Enable Developer Mode in Discord (User Settings -> Advanced),
# then right-click your server icon -> Copy Server ID.
GUILD_ID=

# Optional. Set to "true" only if you're hosting on a free/sleep-prone
# platform (e.g. Replit) and pinging it with an uptime monitor to keep it
# awake. Leave unset/false on a VPS or other always-on host — see the
# README's "Keeping the bot online 24/7" section.
ENABLE_KEEPALIVE=false

# Optional. Port for the keep-alive HTTP server above (default 3000).
PORT=3000

# Lavalink node — powers /play, /skip, etc. This now points at a
# self-hosted node (see /lavalink-server in this repo, deployed as a
# second Render service) instead of free third-party public nodes. Free
# public nodes intermittently return broken/HTML responses while staying
# "connected" (wrong/rotated password, overload, proxy errors) — that's
# what a 403 or an "Unexpected token '<' ... is not valid JSON" error from
# /play means. See lavalink-server/README.md for deploy steps; these
# values must match what you set on that service.
LAVALINK_HOST=
LAVALINK_PORT=443
LAVALINK_PASSWORD=
LAVALINK_SECURE=true
LAVALINK_NODE_ID=

# Optional second node, for failover — uncomment the block in index.js
# too if you set these. Leave blank if you're only running one node.
LAVALINK_HOST2=
LAVALINK_PORT2=
LAVALINK_PASSWORD2=
LAVALINK_SECURE2=
LAVALINK_NODE_ID2=

# Spotify/Apple Music links in /play need NO env vars on the bot itself —
# resolution now happens on the Lavalink node via the LavaSrc plugin. Set
# SPOTIFY_CLIENT_ID/SPOTIFY_CLIENT_SECRET on the *lavalink-server* Render
# service instead (see lavalink-server/README.md). If you previously had
# those two vars set here on the bot, they're unused now and safe to
# delete — the old utils/spotify.js scraping workaround they were for is
# gone (see the comment at the top of that file).

# Optional. Which platform Lavalink searches when /play (or a resolved
# Spotify/Apple Music track) gets a plain search term instead of a direct
# URL. Set to "ytsearch" — SoundCloud (scsearch) turned out to be the
# unreliable one in practice: search/metadata worked, but actual audio
# streams 404'd for every track once tested for real. YouTube is enabled
# on the self-hosted node via the maintained youtube-source plugin (see
# lavalink-server/application.yml) specifically to cover this. If YouTube
# ever becomes the unreliable one instead (it happens, on both sides),
# switch this back to scsearch — no code changes needed either way.
MUSIC_SEARCH_PLATFORM=ytsearch
