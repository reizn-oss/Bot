# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it contains secrets.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
TOKEN=

# Application (Client) ID from the "General Information" tab of your application
CLIENT_ID=

# The Discord server (guild) ID you want the bot to manage.
# Enable Developer Mode in Discord (User Settings -> Advanced),
# then right-click your server icon -> Copy Server ID.
GUILD_ID=

# Optional. Set to "true" only if you're hosting on a free/sleep-prone
# platform (e.g. Replit) and pinging it with an uptime monitor to keep it
# awake. Leave unset/false on a VPS or other always-on host — see the
# README's "Keeping the bot online 24/7" section.
ENABLE_KEEPALIVE=false

# Optional. Port for the keep-alive HTTP server above (default 3000).
PORT=3000

# Lavalink node connection — powers /play, /skip, etc. Defaults in index.js
# point at a free public node (lavalink.jirayu.net). Public nodes can go
# down or change passwords; if music stops working, grab a fresh one from
# https://lavalink.darrennathanael.com/ and set these to override the
# defaults (no code changes needed).
LAVALINK_HOST=
LAVALINK_PORT=
LAVALINK_PASSWORD=
LAVALINK_SECURE=
LAVALINK_NODE_ID=

# Optional. Lets /play accept Spotify playlist/album/track links. Spotify's
# API only gives back track names (it doesn't allow streaming its audio
# outside Spotify's own apps) — the bot looks up each track's name here,
# then plays it via the search platform below (SoundCloud by default).
# Free, no Premium needed: create an app (Client Credentials, no redirect
# URI required) at https://developer.spotify.com/dashboard, then copy its
# Client ID and Client Secret below. Leave blank to leave Spotify links
# unsupported — regular /play still works fine without these.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional. Which platform Lavalink searches when /play (or a resolved
# Spotify track) gets a plain search term instead of a direct URL.
# Defaults to "scsearch" (SoundCloud) because YouTube search (ytsearch)
# increasingly gets blocked/rate-limited from cloud hosting IPs like
# Render's. Only change this to ytsearch/ytmsearch if your chosen Lavalink
# node has that source enabled and working.
MUSIC_SEARCH_PLATFORM=scsearch
