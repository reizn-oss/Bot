# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it contains secrets.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
TOKEN=

# Application (Client) ID from the "General Information" tab of your application
CLIENT_ID=

# The Discord server (guild) ID you want the bot to manage.
# Enable Developer Mode in Discord (User Settings -> Advanced),
# then right-click your server icon -> Copy Server ID.
GUILD_ID=

# Optional. Set to "true" only if you're hosting on a free/sleep-prone
# platform (e.g. Replit) and pinging it with an uptime monitor to keep it
# awake. Leave unset/false on a VPS or other always-on host — see the
# README's "Keeping the bot online 24/7" section.
ENABLE_KEEPALIVE=false

# Optional. Port for the keep-alive HTTP server above (default 3000).
PORT=3000

# Lavalink nodes — power /play, /skip, etc. Three are configured (see
# index.js), deliberately from three *different* free-node operators, not
# just three different hostnames. Free public Lavalink nodes intermittently
# return broken/HTML responses while staying "connected" (wrong/rotated
# password, overload, proxy errors) — if you only diversify hostnames but
# they're the same operator behind the scenes, one bad password rotation
# takes out "all" your nodes at once, which is what happened here in
# mid-2026 when serenetia.com rotated its password and its second hostname
# was retired. The bot automatically retries a failed search on every
# other connected node before giving up (features/music.js,
# searchWithFailover). Leave these blank to use the built-in defaults; if
# ALL default nodes are ever down or a password rotates again, grab fresh
# host/port/password combos from https://lavalink.darrennathanael.com/
# (that page is kept current — this file is not, so check there first
# whenever /play starts erroring with something like "Unexpected token
# '<' ... is not valid JSON", which means a node sent back an HTML error
# page instead of JSON, usually a wrong/expired password) and set these to
# override.
LAVALINK_HOST=
LAVALINK_PORT=
LAVALINK_PASSWORD=
LAVALINK_SECURE=
LAVALINK_NODE_ID=

# Second node, for failover — a different operator than node 1. Leave
# blank to use the built-in default second node.
LAVALINK_HOST2=
LAVALINK_PORT2=
LAVALINK_PASSWORD2=
LAVALINK_SECURE2=
LAVALINK_NODE_ID2=

# Third node, for failover — a different operator than nodes 1 and 2.
# Leave blank to use the built-in default third node.
LAVALINK_HOST3=
LAVALINK_PORT3=
LAVALINK_PASSWORD3=
LAVALINK_SECURE3=
LAVALINK_NODE_ID3=

# Spotify playlist/album/track links in /play need NO env vars at all —
# utils/spotify.js authenticates the same anonymous way open.spotify.com
# itself does for a logged-out visitor (TOTP-signed request, secret pulled
# live from a community mirror of Spotify's web player bundle). Nothing to
# configure here; if you previously had SPOTIFY_CLIENT_ID/SECRET set from
# an older version of this bot, they're unused now and safe to delete —
# the Client Credentials flow they were for got restricted by Spotify in
# Feb 2026 (see the comment at the top of utils/spotify.js).

# Optional. Which platform Lavalink searches when /play (or a resolved
# Spotify track) gets a plain search term instead of a direct URL.
# Defaults to "scsearch" (SoundCloud) because YouTube search (ytsearch)
# increasingly gets blocked/rate-limited from cloud hosting IPs like
# Render's. Only change this to ytsearch/ytmsearch if your chosen Lavalink
# node has that source enabled and working.
MUSIC_SEARCH_PLATFORM=scsearch
